# Copy to /opt/quazar/coinex-bot.env (chmod 600) and fill secrets.
# Standalone systemd unit: coinex-bot.service
#   systemctl enable --now coinex-bot
#   systemctl status coinex-bot
# Rebuild image (not via quazar compose):
#   docker build -t quazar-coinex-bot:latest /opt/quazar/coinex-bot
#   systemctl restart coinex-bot

COINEX_API_KEY=
COINEX_API_SECRET=

MARKET=KOMAUSDT
MARKET_TYPE=spot
TRADE_SIDE=buy

INITIAL_LOT=0.001
MAX_LOT=0.064
INITIAL_LOT_SPOT=100
MAX_LOT_SPOT=6400

# Absolute price offsets ("пункты"), not percent.
# BUY: TP = last + TP_POINTS, soft SL = last - SL_POINTS.
# Example for KOMAUSDT ~0.01: 0.001 = +0.001 к цене.
TP_POINTS=0.001
SL_POINTS=0.001

LEVERAGE=10
MARGIN_MODE=cross
TP_SL_TRIGGER=latest_price

RUST_LOG=info
