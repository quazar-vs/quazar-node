# Copy to /opt/quazar/coinex-bot.env (chmod 600) and fill secrets.
# Standalone systemd unit: coinex-bot.service
#   systemctl enable --now coinex-bot
#   systemctl status coinex-bot
# Rebuild image (not via quazar compose):
#   docker build -t quazar-coinex-bot:latest /opt/quazar/coinex-bot
#   systemctl restart coinex-bot

COINEX_API_KEY=
COINEX_API_SECRET=

MARKET=KOMAUSDT
MARKET_TYPE=spot
TRADE_SIDE=buy

LOT_COEFF=1
LOT_STEP_COEFF=2
# Soft-SL ladder: entry + MAX_SOFT_SL_ADDS full adds (default 6 → 7 levels).
# Cap = quote balance for full ladder (no MAX_LOT).
MAX_SOFT_SL_ADDS=6

# One percent for both TP and SL (from first entry).
TP_SL_PERCENT=10

LEVERAGE=10
MARGIN_MODE=cross
TP_SL_TRIGGER=latest_price

RUST_LOG=info
