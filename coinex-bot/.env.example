# CoinEx API credentials (required)
COINEX_API_KEY=your_access_id
COINEX_API_SECRET=your_secret_key

# Trading instrument
MARKET=BTCUSDT

# futures | spot
MARKET_TYPE=futures

# One-sided martingale direction: buy | sell
TRADE_SIDE=buy

# Working min lot = exchange min_amount × LOT_COEFF (rounded to market amount precision).
# Also accepted: LOT_MULTIPLIER
LOT_COEFF=1

# Soft-SL lot multiplier (must be > 1). 2 = double: 100 → 200 → 400.
# Ladder = entry + 8 full adds (9 levels). Cap is USDT balance for the full ladder, not MAX_LOT.
LOT_STEP_COEFF=2

# TP/SL percent distance from first entry (used as fallback).
# BUY:  TP = open × (1 + TP_SL_PERCENT/100), SL = open × (1 − TP_SL_PERCENT/100)
# SELL: mirrored. Example: 5 = ±5%.
# Note: in AUTO_MARKET the bot recomputes TP/SL from the selected pair fee:
# tp_sl_percent = max(maker_fee_rate, taker_fee_rate) * 6 (fee in fractions, result in percent).
TP_SL_PERCENT=10

# Futures account settings (ignored for spot except logging)
LEVERAGE=10
MARGIN_MODE=cross
# mark_price | latest_price | index_price
# Spot defaults to latest_price if unset.
TP_SL_TRIGGER=mark_price

# Optional overrides
# COINEX_REST_URL=https://api.coinex.com/v2
# Futures WS default: wss://socket.coinex.com/v2/futures
# Spot WS default:    wss://socket.coinex.com/v2/spot
# COINEX_WS_URL=wss://socket.coinex.com/v2/spot

# After TP (no hanging bot order): pick most volatile liquid USDT pair with tight spread.
AUTO_MARKET=true
MIN_TURNOVER_USDT=50000
MAX_SPREAD_PCT=0.5
SCANNER_QUOTE=USDT
MARKET_BLACKLIST=USDCUSDT,DAIUSDT,TUSDUSDT,FDUSDUSDT,BUSDUSDT
SCANNER_HOUR_BARS=4
SCANNER_HOUR_RANGE_RATIO=0.30

# Logging: error, warn, info, debug, trace
RUST_LOG=info
