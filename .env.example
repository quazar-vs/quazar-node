POSTGRES_PASSWORD=
DATABASE_URL=
QUAZAR_NODE_SECRET=
QUAZAR_REG_SECRET=
QUAZAR_STRICT_SECRETS=
# Google reCAPTCHA (v2 checkbox or v3). Site key is public; secret stays server-side.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Optional v3: minimum score (default 0.5) and expected action name.
# RECAPTCHA_MIN_SCORE=0.5
# RECAPTCHA_EXPECTED_ACTION=submit
# Trust X-Forwarded-For / X-Real-IP only from these proxy IPs or CIDRs (comma-separated).
# Example behind local nginx: QUAZAR_TRUSTED_PROXIES=127.0.0.1,::1,10.0.0.0/8
QUAZAR_TRUSTED_PROXIES=
QUAZAR_NODE_ID=
QUAZAR_NODE_URL=
QUAZAR_PORT=
QUAZAR_INIT_TEST_KEYS=
QUAZAR_BLOCK_MIN_EVENTS=
QUAZAR_BLOCK_MAX_WAIT_SECS=
QUAZAR_SYNC_INTERVAL_SECS=
QUAZAR_CORS_ORIGINS=
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=
ADMIN_API_KEY=
