POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=
QUAZAR_NETWORK_ID=
QUAZAR_VERSION=
QUAZAR_PEER_URL=
QUAZAR_NODE_SECRET=
QUAZAR_REG_SECRET=
QUAZAR_STRICT_SECRETS=
# Google reCAPTCHA (v2 checkbox or v3). Site key is public; secret stays server-side.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Optional v3: minimum score (default 0.5) and expected action name.
# RECAPTCHA_MIN_SCORE=0.5
# RECAPTCHA_EXPECTED_ACTION=submit
# Extra trusted proxies for X-Forwarded-For / X-Real-IP (comma-separated IPs/CIDRs).
# Primary source is the `nodes` table (alive peers, non-local hosts). Use this env for
# local nginx that is not in the registry.
# Recommended for local nginx reverse-proxy: 127.0.0.1,::1
QUAZAR_TRUSTED_PROXIES=127.0.0.1,::1
QUAZAR_NODE_ID=
# Public peer/API URL advertised to other nodes — NOT http://localhost:8080
# Production example: https://api.quazar.website
QUAZAR_NODE_URL=
# Quazar Passport app download link in credentials emails (GitHub releases / APK asset).
# Passport Flutter app downloads (GitHub Releases).
PASSPORT_DOWNLOAD_URL=https://github.com/quazar-vs/quazar-passport/releases
# Bootstrap network URL for mayor node register (STEP 7); falls back to first QUAZAR_BOOTSTRAP_PEERS entry.
QUAZAR_NETWORK_URL=
QUAZAR_BOOTSTRAP_PEERS=
QUAZAR_PORT=
# false for prod-like; true only seeds demo API keys into PostgreSQL
QUAZAR_INIT_TEST_KEYS=false
QUAZAR_BLOCK_MIN_EVENTS=
QUAZAR_BLOCK_MAX_WAIT_SECS=
QUAZAR_SYNC_INTERVAL_SECS=
QUAZAR_CORS_ORIGINS=
# External SMTP (outbound credentials / verification / admin notify). No internal mailserver.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Auth login: SMTP_USERNAME preferred; SMTP_USER is accepted as alias
SMTP_USERNAME=
# SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Квазар
# true only if your SMTP presents a cert that does not match SMTP_HOST
SMTP_TLS_INSECURE=false
# Admin inbox for new citizenship application notifications
NOTIFY_EMAIL=
# Legacy Gmail SMTP (used only if SMTP_* / SMTP_PASSWORD unset)
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=
ADMIN_API_KEY=
# Hermes Agent gateway (Nous Portal). Generate: openssl rand -hex 32
HERMES_API_KEY=
# SSH tunnels for mobile clients (see scripts/setup-ssh-tunnel-quazar.sh on the host)
SSH_TUNNEL_ENABLED=false
SSH_GATEWAY_PORTS=yes
SSH_KEEPALIVE_INTERVAL=60
SSH_KEEPALIVE_COUNT_MAX=3
VPN_KEY_TTL_HOURS=24
# SSH_TUNNEL_USER=quazar-tunnel
# SSH_TUNNEL_HOST=176.98.191.38
# SSH_TUNNEL_PORT=22
# SSH_TUNNEL_CLIENT_LOCAL_PORT=18443
# SSH_TUNNEL_REMOTE_API_HOST=127.0.0.1
# SSH_TUNNEL_REMOTE_API_PORT=8080
# Optional: sync issued public keys into this authorized_keys file (host-mounted path)
# VPN_AUTHORIZED_KEYS_PATH=/var/lib/quazar/tunnel/authorized_keys
