POSTGRES_PASSWORD=
DATABASE_URL=
QUAZAR_NODE_SECRET=
QUAZAR_REG_SECRET=
QUAZAR_STRICT_SECRETS=
# Google reCAPTCHA (v2 checkbox or v3). Site key is public; secret stays server-side.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Optional v3: minimum score (default 0.5) and expected action name.
# RECAPTCHA_MIN_SCORE=0.5
# RECAPTCHA_EXPECTED_ACTION=submit
# Extra trusted proxies for X-Forwarded-For / X-Real-IP (comma-separated IPs/CIDRs).
# Primary source is the `nodes` table (alive peers, non-local hosts). Use this env for
# local nginx that is not in the registry, e.g. QUAZAR_TRUSTED_PROXIES=127.0.0.1,::1
QUAZAR_TRUSTED_PROXIES=
QUAZAR_NODE_ID=
QUAZAR_NODE_URL=
# Bootstrap network URL for mayor node register (STEP 7); falls back to first QUAZAR_BOOTSTRAP_PEERS entry.
QUAZAR_NETWORK_URL=
QUAZAR_BOOTSTRAP_PEERS=
QUAZAR_PORT=
QUAZAR_INIT_TEST_KEYS=
QUAZAR_BLOCK_MIN_EVENTS=
QUAZAR_BLOCK_MAX_WAIT_SECS=
QUAZAR_SYNC_INTERVAL_SECS=
QUAZAR_CORS_ORIGINS=
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=
ADMIN_API_KEY=
